{
    "name": "axvi/wiretap-laravel",
    "description": "Laravel event collector for Wiretap, a self-hosted application inspector and monitoring tool",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "axvi",
            "email": "axvi.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-zlib": "*",
        "illuminate/support": "^12.0|^13.0"
    },
    "suggest": {
        "ext-redis": "Required for Redis driver with PhpRedis",
        "predis/predis": "Required for Redis driver with Predis"
    },
    "keywords": [
        "laravel",
        "debug",
        "inspector",
        "monitoring",
        "telescope",
        "observability"
    ],
    "homepage": "https://github.com/axvilab/wiretap",
    "autoload": {
        "psr-4": {
            "Axvi\\Wiretap\\": "laravel-package/src/"
        },
        "files": [
            "laravel-package/src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Axvi\\Wiretap\\WiretapServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
