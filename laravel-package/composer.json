{
    "name": "axvi/wiretap-laravel",
    "description": "Lightweight Laravel application inspector — event collector for Wiretap",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "axvi",
            "email": "axvi.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Axvi\\Wiretap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Axvi\\Wiretap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Axvi\\Wiretap\\WiretapServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
