{
    "name": "axvi/wiretap-laravel",
    "description": "Lightweight Laravel application inspector — event collector for Wiretap",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "axvi",
            "email": "axvi.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-zlib": "*",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "suggest": {
        "ext-redis": "Required for Redis driver with PhpRedis",
        "predis/predis": "Required for Redis driver with Predis"
    },
    "autoload": {
        "psr-4": {
            "Axvi\\Wiretap\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Axvi\\Wiretap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Axvi\\Wiretap\\WiretapServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
